# Required in production. Use managed PostgreSQL; SQLite is for local development only.
DATABASE_URL=postgresql://user:password@host:5432/rentproof

# Email verification via Resend. Configure a verified sender for production.
RESEND_API_KEY=
MAIL_FROM=RentProof <no-reply@example.com>

# First administrator bootstrap. Generate a random token of at least 24 characters.
OWNER_EMAIL=owner@example.com
OWNER_BOOTSTRAP_TOKEN=

# Optional session hardening/configuration
AUTH_SECRET=

# AI is server-side only; never expose these values with NEXT_PUBLIC_ prefix.
TOKENLAVKA_API_KEY=
TOKENLAVKA_BASE_URL=https://tokenlavka.com/v1
TOKENLAVKA_MODEL=gpt-6-luna

# Local development only
# RENTPROOF_DB_PATH=./data/rentproof-v3.sqlite
