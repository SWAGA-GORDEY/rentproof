# Copy to .env. Do not commit real secrets.

RENTPROOF_DB_PATH=./data/rentproof.sqlite
RENTPROOF_UPLOAD_DIR=./data/uploads
RENTPROOF_COOKIE_SECURE=0
NEXT_PUBLIC_SITE_URL=http://localhost:3000
GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=

RENTPROOF_ADMIN_EMAIL=
RENTPROOF_ADMIN_PASSWORD=

# TokenLavka (server-only)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://tokenlavka.com/v1
OPENAI_MODEL=gpt-6-luna
OPENAI_VISION_MODEL=

# Mail adapter: auto | smtp | console
MAIL_DRIVER=auto
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Legal operator placeholders (leave empty until owner fills real data)
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_ADDRESS=
LEGAL_OPERATOR_EMAIL=
LEGAL_OPERATOR_INN=
LEGAL_OPERATOR_OGRN=

# Plan prices (RUB / month) and limits — change without rewriting business logic
RENTPROOF_PLAN_FREE_PRICE_RUB=0
RENTPROOF_PLAN_PLUS_PRICE_RUB=299
RENTPROOF_PLAN_PRO_PRICE_RUB=799
RENTPROOF_PLAN_FREE_LISTINGS=3
RENTPROOF_PLAN_PLUS_LISTINGS=25
RENTPROOF_PLAN_PRO_LISTINGS=200
RENTPROOF_PLAN_FREE_AI=5
RENTPROOF_PLAN_PLUS_AI=40
RENTPROOF_PLAN_PRO_AI=150
RENTPROOF_PLAN_FREE_HISTORY=20
RENTPROOF_PLAN_PLUS_HISTORY=200
RENTPROOF_PLAN_PRO_HISTORY=1000
RENTPROOF_PLAN_FREE_CUSTOMERS=20
RENTPROOF_PLAN_PLUS_CUSTOMERS=200
RENTPROOF_PLAN_PRO_CUSTOMERS=2000

# Listings: 1 = publish on submit (default). 0 = require admin moderation.
RENTPROOF_LISTING_AUTO_PUBLISH=1

# Payments stay OFF until owner sets RENTPROOF_PAYMENTS_ENABLED=1 and test keys.
RENTPROOF_PAYMENTS_ENABLED=0
RENTPROOF_BILLING_PROVIDER=yookassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_API_URL=https://api.yookassa.ru/v3
YOOKASSA_MODE=test
YOOKASSA_RETURN_URL=http://localhost:3000/payments/return
YOOKASSA_WEBHOOK_SECRET=
RENTPROOF_YOOKASSA_FAKE=0
RENTPROOF_PLATFORM_FEE_BPS=500
