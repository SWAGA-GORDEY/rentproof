# Copy to .env. Do not commit real secrets.

RENTPROOF_DB_PATH=./data/rentproof.sqlite
RENTPROOF_UPLOAD_DIR=./data/uploads
RENTPROOF_COOKIE_SECURE=0
# Public origin for canonical URLs, sitemap and robots (must be https://… in production).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional Search Console / Yandex Webmaster verification meta (values only, no HTML tags).
GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=

# Optional. Leave empty until a real administrator is created with npm run admin:bootstrap.
RENTPROOF_ADMIN_EMAIL=
RENTPROOF_ADMIN_PASSWORD=

# TokenLavka (OpenAI-compatible). Keys are read ONLY on the Node server via process.env.
# Never put these in NEXT_PUBLIC_* , localStorage, or client components.
OPENAI_API_KEY=
# Optional alias accepted by the server if OPENAI_API_KEY is empty:
# TOKENLAVKA_KEY=
OPENAI_BASE_URL=https://tokenlavka.com/v1
# Prefer OPENAI_MODEL; OPENAI_VISION_MODEL remains a supported alias.
OPENAI_MODEL=gpt-6-luna
OPENAI_VISION_MODEL=

# Optional. Mail is not sent in this version even if these are set.
SMTP_HOST=
SMTP_FROM=

# --- ЮKassa (TEST ONLY) ---
# Create a test shop in ЮKassa cabinet, then paste shop id + secret key in Render.
# Never put secrets in NEXT_PUBLIC_* or commit them to Git.
RENTPROOF_BILLING_PROVIDER=yookassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_API_URL=https://api.yookassa.ru/v3
YOOKASSA_MODE=test
YOOKASSA_RETURN_URL=http://localhost:3000/payments/return
# Optional custom header check for /api/payments/yookassa/webhook (not required by ЮKassa).
YOOKASSA_WEBHOOK_SECRET=
# Local/dev only: in-memory fake provider (no network). Do NOT enable on production Render.
RENTPROOF_YOOKASSA_FAKE=0
# Platform fee in basis points (500 = 5% of rental amount).
RENTPROOF_PLATFORM_FEE_BPS=500
